# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy frontend source files
COPY app.json babel.config.js tsconfig.json index.js App.tsx ./
COPY web ./web
COPY src ./src

ARG EXPO_PUBLIC_API_URL=/api
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL

# Export static web bundle
RUN npx expo export -p web && \
    cp web/LiPurnoPran*.ttf dist/ && \
    sed -i '/<head>/a <style>@font-face{font-family:"PurnoPran";src:url("/LiPurnoPran.ttf") format("truetype");font-weight:normal;font-style:normal;}@font-face{font-family:"PurnoPran";src:url("/LiPurnoPran-Italic.ttf") format("truetype");font-weight:normal;font-style:italic;}@font-face{font-family:"PurnoPran";src:url("/LiPurnoPran.ttf") format("truetype");font-weight:bold;font-style:normal;}*,*::before,*::after,html,body,input,button,textarea,select,div,span,p{font-family:"PurnoPran",sans-serif !important;}</style>' dist/index.html

# Production web server using Nginx
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY web/LiPurnoPran*.ttf /usr/share/nginx/html/
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
