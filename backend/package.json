{
  "name": "chalarot-api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx scripts/wait-for-db.ts && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "tsx scripts/wait-for-db.ts && prisma migrate deploy",
    "start": "node dist/index.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "~5.3.3"
  }
}
